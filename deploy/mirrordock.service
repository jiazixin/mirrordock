[Unit]
Description=MirrorDock source mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mirrordock
Group=mirrordock
WorkingDirectory=/etc/mirrordock
ExecStart=/usr/local/bin/mirrordock --config /etc/mirrordock/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
LimitNOFILE=8192
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/mirrordock /var/lib/mirrordock /srv/mirrors

[Install]
WantedBy=multi-user.target
