{
  "name": "mirrordock-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "vue-tsc --noEmit",
    "format": "prettier --write src e2e *.ts index.html package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src e2e *.ts index.html package.json tsconfig.json .prettierrc.json",
    "build": "npm run check && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
